function totals(app){
  const L=app.lines;
  const by=c=>sum(L.filter(l=>l.category===c).map(l=>l.amount));
  const t={
    total:sum(L.map(l=>l.amount)),
    food:by("Event: Food")+by("Trip: Food"), admin:by("Admin Item"), storage:by("Storage"), speakers:by("Event: Guest Speaker"),
    hotels:by("Trip: Hotels"), flights:by("Trip: Flights"),
    events:sum(L.filter(l=>l.group==="event").map(l=>l.amount)), nonevent:sum(L.filter(l=>l.group==="nonevent").map(l=>l.amount))
  };
  const tier=Number(app.org.tier)||0;
  t.tierMax=(TIERS[tier]||0); t.cap=Math.max(0,t.tierMax-(Number(app.org.prior)||0));
  t.foodCap=FOOD_CAP[tier]||0;
  t.hotelCap=50*app.events.filter(e=>e.type==="Trip").reduce((a,e)=>a+(Number(e.people)||0)*(Number(e.nights)||0),0);
  t.flightCap=300*app.events.filter(e=>e.type==="Trip").reduce((a,e)=>a+(Number(e.flightPeople)||0),0);
  return t;
}
