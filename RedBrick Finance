  if(t.flights>t.flightCap)add("error",`Flights ${money(t.flights)} are over ${money(t.flightCap)} ($300 per person round trip).`,SRC.tpl);
  if(app.lines.some(l=>l.category==="Trip: Gas"))add("info","Trip gas: if you rent vehicles, file a separate RENTAL/GAS CARDS Spend Authorization (one card per vehicle). Drivers 18–20 must use Hertz.","Canvas: Transportation (8.19)");
