function parseTranscript(text){
  const res={tier:null,prior:null,events:[],lines:[],allOnHub:false};
  const rows=text.split(/\n+/).map(s=>s.replace(/^[A-Z][\w .'-]*\([^)]*\):\s*|^[A-Z][\w'-]*:\s(?=[A-Z])/,"").trim()).filter(Boolean);
  let curEv=null;
  const dateRe=/\b(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\.? (\d{1,2})(?:\s*(?:to|through|-|–)\s*(?:(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\.? )?(\d{1,2}))?/;
  const amounts=s=>[...s.matchAll(/\$\s?([\d,]+(?:\.\d{1,2})?)/g)].map(m=>parseFloat(m[1].replace(/,/g,"")));
  for(const row of rows){
    const tierM=row.match(/tier\s*(\d)/i); if(tierM&&!/^(event|trip|non-event)/i.test(row)){res.tier=+tierM[1]; if(/(haven't|hasn't|nothing|zero|no funding)/i.test(row))res.prior=0; continue;}
    if(/listed on (miami central|the hub)/i.test(row)){res.allOnHub=true;continue}
    let m=row.match(/^(event|trip)\b[^:]*:\s*(.*)$/i);
    if(m){
      const type=/trip/i.test(m[1])?"Trip":"Event";
      let rest=m[2].replace(/^the\s+/i,"");
      const name=rest.split(/,| every | from | on | in (?=[A-Z])|\. /)[0].trim().replace(/\.$/,"");
      const d=rest.match(dateRe); let date="";
      if(d){date=`${d[1]} ${d[2]}`+(d[4]?` – ${d[3]?d[3]+" ":""}${d[4]}`:"")}
      curEv={id:uid(),type,name,date,people:0,nights:0,flightPeople:0,onHub:false};
      if(type==="Trip"){const p=rest.match(/(\w+) (?:people|members|students)/i);const n=rest.match(/(\w+) nights?/i);curEv.people=toNum(p&&p[1]);curEv.nights=toNum(n&&n[1]);const f=rest.match(/(\w+) (?:flights|plane tickets)/i);curEv.flightPeople=toNum(f&&f[1])}
      res.events.push(curEv);
      const hotel=rest.match(/\$([\d.]+) per person per night/i);
      if(hotel&&curEv){res.lines.push(mkLine("event",curEv.id,"Hotel","Trip: Hotels",Number(hotel[1])*curEv.people*curEv.nights,"",`${money(hotel[1])} × ${curEv.people} people × ${curEv.nights} nights`));continue}
      const a=amounts(rest); if(a.length) res.lines.push(...[].concat(fromSentence(rest,a,curEv)));
      continue;
    }
    m=row.match(/^non-event\b[^:]*:\s*(.*)$/i);
    if(m){
      const rest=m[1]; const a=amounts(rest); if(!a.length)continue;
      let item=rest.split(/,/)[0].replace(/^(a|an|the)\s+/i,"").trim(); item=item.charAt(0).toUpperCase()+item.slice(1);
      let cat="Admin Item";
      if(/capital|keep (it )?for years|tent|table cover|equipment/i.test(rest))cat="Capital Item";
      else if(/banner/i.test(rest))cat="Banners"; else if(/storage/i.test(rest))cat="Storage"; else if(/flyer|marketing|advert|poster/i.test(rest))cat="Marketing";
      res.lines.push(mkLine("nonevent",null,item.replace(/ from .*/,""),cat,a[a.length-1],vendorOf(rest),""));
      continue;
    }
    const a=amounts(row);
    if(a.length&&curEv) res.lines.push(...[].concat(fromSentence(row,a,curEv)));
  }
  if(res.allOnHub)res.events.forEach(e=>e.onHub=true);
  return res;
}
function fromSentence(s,a,ev){
  const trip=ev.type==="Trip"; let cat,item;
  if(/gas|fuel|gallon/i.test(s)){cat="Trip: Gas";item="Gas (two vehicles)"}
  else if(/flight|airfare|plane/i.test(s)){cat="Trip: Flights";item="Flights"}
  else if(/hotel|lodging/i.test(s)){cat="Trip: Hotels";item="Hotel"}
  else if(/cater|food|pizza|meal|dinner|lunch|breakfast|snack/i.test(s)){cat=trip?"Trip: Food":"Event: Food";item=trip?"Meals":"Catering"}
  else if(/speaker|honorari/i.test(s)){cat="Event: Guest Speaker";item="Speaker honoraria"}
  else if(/\bdj\b|band|entertain|perform/i.test(s)){cat="Event: Entertainer";item="Entertainer"}
  else if(/lane|room|venue|space|rental|facility/i.test(s)){cat=trip?"Trip: Other Travel":"Event: Space Fee";item=/lane/i.test(s)?"Lane rental":"Venue rental"}
  else if(/flyer|poster|marketing|advert/i.test(s)){cat="Event: Marketing";item="Marketing"}
  else {cat=trip?"Trip: Other Travel":"Event: Other";item="Expense"}
  const cnt=s.match(/(\w+) speakers? at (?:a )?\$([\d,]+)/i);
  let note=s.length>140?s.slice(0,137)+"…":s;
  if(cnt&&toNum(cnt[1])>1){const n=toNum(cnt[1]),each=parseFloat(cnt[2].replace(/,/g,""));return Array.from({length:n},(_,k)=>mkLine("event",ev.id,`Speaker ${k+1} honorarium`,cat,each,"",`${n} speakers × ${money(each,{whole:true})}`))}
  return mkLine("event",ev.id,item,cat,a[a.length-1],vendorOf(s),note);
}
const MONTHS=/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/;
function vendorOf(s){for(const m of s.matchAll(/from ([A-Z][\w'&]*(?: [A-Z][\w'&]*)*)/g)){if(!MONTHS.test(m[1]))return m[1]}return ""}
function mkLine(group,eventId,item,category,amount,vendor,note){return {id:uid(),group,eventId,item,category,amount:Math.round(Number(amount)*100)/100,vendor:vendor||"",note:note||"",quote:""}}

async function aiExtract(text){
  const prompt=`You turn a student organization's meeting transcript into an ASG (Associated Student Government, Miami University) club funding proposal.
Return ONLY JSON with this shape:
