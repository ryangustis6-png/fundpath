  if(missingQ.length)flags.push({sev:"review",msg:`${missingQ.length} receipt(s) are missing Who/What/Where/Why answers for the Workday Receipts Questionnaire.`});
  return {rows,un,spent,approvedTotal,loaded:Number(app.card.loaded)||0,flags};
