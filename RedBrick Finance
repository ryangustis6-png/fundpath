<style>
/* Layout: sticky top bar with role switch; org view = step rail (7 steps from the team's desired flow) + work area + side panel; ASG/AP views = queue + detail. */
:root{
  --bg:#f6f3f2; --surface:#ffffff; --surface-2:#fbf9f8; --ink:#1d1718; --muted:#6b6264; --line:#e4dcda;
  --accent:#b0142b; --accent-soft:#f8e4e6; --accent-ink:#ffffff;
  --ok:#1d7346; --ok-soft:#e3f2e9; --warn:#9a5800; --warn-soft:#fbefd9; --bad:#b3261e; --bad-soft:#fbe5e3; --info:#2b5c8a; --info-soft:#e4eef8;
  --f-display:"Archivo","Helvetica Neue",Arial,sans-serif;
  --f-body:"Source Sans 3","Segoe UI",system-ui,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  --r:10px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141011; --surface:#1e1819; --surface-2:#191415; --ink:#f2ecea; --muted:#a99fa0; --line:#362d2e;
  --accent:#e4485f; --accent-soft:#3a1a20; --accent-ink:#ffffff;
  --ok:#5cc792; --ok-soft:#173226; --warn:#e5a54d; --warn-soft:#3a2a12; --bad:#f2786d; --bad-soft:#3d1a17; --info:#86b6e6; --info-soft:#162637;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141011; --surface:#1e1819; --surface-2:#191415; --ink:#f2ecea; --muted:#a99fa0; --line:#362d2e;
  --accent:#e4485f; --accent-soft:#3a1a20; --accent-ink:#ffffff;
  --ok:#5cc792; --ok-soft:#173226; --warn:#e5a54d; --warn-soft:#3a2a12; --bad:#f2786d; --bad-soft:#3d1a17; --info:#86b6e6; --info-soft:#162637;
  color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
h1,h2,h3,h4{font-family:var(--f-display);margin:0;text-wrap:balance;line-height:1.2}
h2{font-size:1.35rem;font-weight:800}
h3{font-size:1.05rem;font-weight:700}
p{margin:0}
a{color:var(--accent)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.mono{font-family:var(--f-mono);font-size:.86em}
.num{font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}
.small{font-size:.86rem}
.eyebrow{font-family:var(--f-display);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--surface);border-bottom:1px solid var(--line)}
.top-in{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));max-width:1360px;margin:0 auto}
.brand{display:flex;align-items:center;gap:10px;margin-right:auto}
.mark{width:30px;height:30px;border-radius:7px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-family:var(--f-display);font-weight:800;font-size:15px}
.brand b{font-family:var(--f-display);font-weight:800;font-size:1.08rem}
.brand span{display:block;font-size:.76rem;color:var(--muted);line-height:1.1}
.seg{display:flex;background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:3px;gap:2px;flex-wrap:wrap}
.seg button{border:0;background:transparent;padding:6px 12px;border-radius:999px;cursor:pointer;font-weight:600;font-size:.88rem;color:var(--muted);display:flex;gap:6px;align-items:center}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.badge{min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--accent);color:var(--accent-ink);font-size:.72rem;display:inline-grid;place-items:center;font-weight:700}
.seg button[aria-pressed="true"] .badge{background:var(--accent-ink);color:var(--accent)}
.store{font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--muted)}
.dot.on{background:var(--ok)}

.wrap{max-width:1360px;margin:0 auto;padding-block:20px 60px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.grid-org{display:grid;grid-template-columns:200px minmax(0,1fr) 290px;gap:20px;align-items:start}
@media (max-width:1180px){.grid-org{grid-template-columns:210px minmax(0,1fr)}.side{grid-column:1/-1}}
@media (max-width:760px){.grid-org{grid-template-columns:minmax(0,1fr)}}

/* step rail */
.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 70px);display:flex;flex-direction:column;gap:4px}
@media (max-width:760px){.rail{position:static;flex-direction:row;overflow-x:auto;padding-bottom:4px}}
.step{display:grid;grid-template-columns:26px 1fr;gap:4px 10px;align-items:center;text-align:left;border:1px solid transparent;background:transparent;border-radius:var(--r);padding:8px 10px;cursor:pointer;min-width:0}
@media (max-width:760px){.step{min-width:170px}}
.step:hover{background:var(--surface)}
.step[aria-current="step"]{background:var(--surface);border-color:var(--line)}
.step .n{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;font-size:.82rem;color:var(--muted);grid-row:span 2}
.step.done .n{background:var(--ok);border-color:var(--ok);color:#fff}
.step.now .n{border-color:var(--accent);color:var(--accent)}
.step .t{font-weight:700;font-size:.92rem;line-height:1.2}
.step .o{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:600}
.timer{margin-top:10px;padding:10px;border:1px dashed var(--line);border-radius:var(--r);font-size:.82rem}
@media (max-width:760px){.timer{display:none}}

/* cards */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:16px;min-width:0}
.panel-head{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:flex-end;justify-content:space-between}
.main{display:flex;flex-direction:column;gap:16px;min-width:0}
.side{display:flex;flex-direction:column;gap:16px;min-width:0}
.sub{border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:12px}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px 14px}
label.f{display:flex;flex-direction:column;gap:4px;font-size:.8rem;color:var(--muted);font-weight:600;min-width:0}
input[type=text],input[type=number],input[type=date],input[type=email],select,textarea{width:100%;min-width:0;background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:7px 9px;font-size:.92rem;color:var(--ink)}
textarea{resize:vertical;min-height:90px}
input:focus,select:focus,textarea:focus{border-color:var(--accent);outline:none}
.check{display:flex;gap:8px;align-items:flex-start;font-size:.9rem}
.check input{margin-top:4px;accent-color:var(--accent)}

.btn{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 14px;font-weight:600;cursor:pointer;display:inline-flex;gap:6px;align-items:center;font-size:.9rem}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(1.07)}
.btn.good{background:var(--ok);border-color:var(--ok);color:#fff}
.btn.bad{color:var(--bad);border-color:var(--bad)}
.btn.sm{padding:4px 9px;font-size:.8rem}
.btn:disabled{opacity:.45;cursor:not-allowed;filter:none}
.icon-btn{border:0;background:transparent;cursor:pointer;color:var(--muted);padding:4px 6px;border-radius:6px}
.icon-btn:hover{background:var(--surface-2);color:var(--bad)}

.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th{font-family:var(--f-display);font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:left;padding:8px 10px;background:var(--surface-2);border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:6px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
tr:last-child td{border-bottom:0}
td.r,th.r{text-align:right}
td input,td select{padding:5px 7px;font-size:.86rem}
td select{min-width:130px}
td input[type=number]{min-width:92px}
.tbl-wrap table.wide{min-width:820px}
.note1{display:block;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
tfoot td{font-weight:700;background:var(--surface-2)}

.pill{display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:999px;font-size:.76rem;font-weight:700;white-space:nowrap}
.p-ok{background:var(--ok-soft);color:var(--ok)}
.p-warn{background:var(--warn-soft);color:var(--warn)}
.p-bad{background:var(--bad-soft);color:var(--bad)}
.p-info{background:var(--info-soft);color:var(--info)}
.p-mute{background:var(--surface-2);color:var(--muted);border:1px solid var(--line)}
.p-accent{background:var(--accent-soft);color:var(--accent)}

.issue{display:grid;grid-template-columns:auto 1fr;gap:4px 10px;padding:10px 12px;border-radius:var(--r);border:1px solid var(--line);background:var(--surface-2)}
.issue .src{font-size:.76rem;color:var(--muted)}
.issue.error{border-color:color-mix(in srgb,var(--bad) 40%,var(--line))}
.issue.review{border-color:color-mix(in srgb,var(--warn) 40%,var(--line))}
.issues{display:flex;flex-direction:column;gap:8px}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.stat{border:1px solid var(--line);border-radius:var(--r);padding:12px;background:var(--surface-2)}
.stat .v{font-family:var(--f-display);font-weight:800;font-size:1.35rem;font-variant-numeric:tabular-nums}
.stat .k{font-size:.78rem;color:var(--muted)}
.meter{height:8px;border-radius:4px;background:var(--line);overflow:hidden}
.meter i{display:block;height:100%;background:var(--ok)}
.meter i.over{background:var(--bad)}
.meter i.near{background:var(--warn)}
.caps{display:flex;flex-direction:column;gap:10px}
.cap{display:grid;grid-template-columns:1fr auto;gap:4px 10px;font-size:.86rem}
.cap .meter{grid-column:1/-1}

/* meeting */
.meeting{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
.transcript{border:1px solid var(--line);border-radius:var(--r);background:var(--surface-2);max-height:340px;overflow:auto;padding:6px}
.utt{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:8px;border-radius:8px}
.utt.on{background:var(--accent-soft)}
.av{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);font-weight:800;color:#fff;font-size:.82rem}
.utt .who{font-size:.78rem;color:var(--muted);font-weight:600}
.wave{display:inline-flex;gap:2px;align-items:flex-end;height:14px}
.wave i{width:3px;background:var(--accent);border-radius:2px;animation:w 0.9s ease-in-out infinite}
.wave i:nth-child(2){animation-delay:.15s}.wave i:nth-child(3){animation-delay:.3s}.wave i:nth-child(4){animation-delay:.45s}
@keyframes w{0%,100%{height:4px}50%{height:14px}}
@media (prefers-reduced-motion:reduce){.wave i{animation:none;height:8px}}

/* notices */
.notice{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:var(--r);border:1px solid var(--line);background:var(--surface)}
.notice.hot{border-color:var(--accent);background:var(--accent-soft)}
.notice .when{font-size:.74rem;color:var(--muted)}
.log{display:flex;flex-direction:column;gap:0;font-size:.84rem}
.log div{display:grid;grid-template-columns:62px 1fr;gap:8px;padding:6px 0;border-bottom:1px solid var(--line)}
.log div:last-child{border-bottom:0}
.log .a{font-weight:700}

.banner{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:14px 16px;border-radius:12px}
.banner.ok{background:var(--ok-soft);color:var(--ok)}
.banner.warn{background:var(--warn-soft);color:var(--warn)}
.banner.bad{background:var(--bad-soft);color:var(--bad)}
.banner.info{background:var(--info-soft);color:var(--info)}
.banner b{font-family:var(--f-display)}
.banner p{color:var(--ink)}

/* queue */
.grid-q{display:grid;grid-template-columns:320px minmax(0,1fr);gap:20px;align-items:start}
@media (max-width:900px){.grid-q{grid-template-columns:minmax(0,1fr)}}
.q{display:flex;flex-direction:column;gap:8px}
.qi{display:flex;flex-direction:column;gap:6px;text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:var(--r);padding:12px;cursor:pointer}
.qi[aria-current="true"]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
.qi .row{justify-content:space-between}
.empty{padding:30px 20px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px;display:flex;flex-direction:column;gap:8px;align-items:center}

.checks{display:flex;flex-direction:column;gap:6px}
.ck{display:grid;grid-template-columns:22px 1fr;gap:8px;font-size:.9rem}
.ck .m{font-weight:800}
.ck.ok .m{color:var(--ok)} .ck.no .m{color:var(--bad)} .ck.na .m{color:var(--warn)}

.ai{border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;background:var(--surface-2);font-size:.9rem;white-space:pre-wrap}
details summary{cursor:pointer;font-weight:600}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;font-weight:600;z-index:20;max-width:calc(100% - 32px)}
.drawer{position:fixed;right:0;top:0;bottom:0;width:min(420px,100%);background:var(--surface);border-left:1px solid var(--line);z-index:15;display:flex;flex-direction:column;padding:calc(16px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(16px + env(safe-area-inset-bottom,0px)) 16px;gap:12px;box-shadow:-10px 0 30px rgba(0,0,0,.12)}
.drawer .body{overflow:auto;display:flex;flex-direction:column;gap:12px;flex:1}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:.88rem}
.kv dt{color:var(--muted)}
.kv dd{margin:0}
.hr{height:1px;background:var(--line)}
</style>

