}
function apDetail(app){
  const sa=app.sa; const sug=apSuggestion(app); const c=apChecks(app); const open=app.status==="sa_submitted";
  return `<div class="panel">
    <div class="panel-head"><div><span class="eyebrow">${esc(sa.worktag)} · ${sa.fund} / ${sa.program}</span><h2>${esc(app.org.name)} · ${money(sa.total)}</h2></div>${statusPill(app.status)}</div>
    <div class="banner ${sug.tone}"><b>Suggested: ${sug.verdict}</b><p>${sug.why.map(esc).join(" · ")}</p></div>
    <div class="checks">${c.map(x=>`<div class="ck ${x.ok?"ok":x.warn?"na":"no"}"><span class="m">${x.ok?"✓":x.warn?"!":"✕"}</span><span>${esc(x.ok?x.t:x.f)}</span></div>`).join("")}</div>
    <div class="tbl-wrap"><table><thead><tr><th>Spend category</th><th class="r">Amount</th><th>Memo</th></tr></thead><tbody>
      ${sa.lines.map(l=>`<tr><td class="small">${l.sc==="FUEL"?"":`<span class="mono">${l.sc}</span> · `}${esc(SPEND_CATS[l.sc]||l.sc)}</td><td class="r num">${money(l.amount)}</td><td class="small">${esc(l.memo)}</td></tr>`).join("")}
    </tbody><tfoot><tr><td>Total</td><td class="r num">${money(sa.total)}</td><td></td></tr></tfoot></table></div>
    <details><summary>Justification and dates</summary><p class="small" style="margin-top:8px">${esc(sa.justification)}</p><p class="small muted">${sa.start} to ${sa.end} · ${sa.description} · ${sa.businessPurpose}</p></details>
    ${UI.apAi&&UI.apAi.id===app.id?`<div class="ai">${esc(UI.apAi.text)}</div>`:""}
    ${open?`<label class="f" for="ap-note">Note to the org (required to return) <input type="text" id="ap-note" placeholder="e.g. Fuel needs a separate RENTAL/GAS CARDS request"></label>
      <div class="row" style="justify-content:space-between"><button class="btn" data-act="ap-ai" ${Store.sample?"":"disabled"}>Second opinion from Claude</button>
      <div class="row"><button class="btn bad" data-act="ap-return">Return</button><button class="btn good" data-act="ap-approve">Approve and load ${money(sa.total)}</button></div></div>`
    :app.status==="card_ready"?`<div class="sub"><h3>Card pickup</h3><div class="row"><label class="f" style="max-width:180px">Card last 4 <input type="text" id="ap-last4" inputmode="numeric" maxlength="4" placeholder="1234"></label><button class="btn primary" data-act="ap-picked" style="align-self:end">Mark picked up</button></div></div>`
    :`<div class="banner ${app.status==="sa_returned"?"bad":"ok"}"><b>${app.status==="sa_returned"?"Returned":"Card active"}</b><p>${esc(app.ap?.note||"")} ${app.card.last4?"Card ending "+esc(app.card.last4)+".":""}</p></div>`}
  </div>`;
}

/* ============================== POLICY HELP ============================== */
function renderDrawer(){
  const d=$("#drawer"); d.hidden=!UI.help; if(!UI.help){d.innerHTML="";return}
  const q=UI.helpQ.toLowerCase().trim();
  const hits=q?POLICY.filter(p=>q.split(/\s+/).some(w=>w.length>2&&(p[0]+" "+p[1]).toLowerCase().includes(w))):POLICY;
  d.innerHTML=`<div class="row" style="justify-content:space-between"><h3>Policy help</h3><button class="btn sm" data-act="help-close">Close</button></div>
  <form id="help-form" class="row"><input type="text" id="help-q" value="${esc(UI.helpQ)}" placeholder="e.g. Can we buy shirts with ASG money?" style="flex:1"><button class="btn primary" type="submit">Ask</button></form>
  <div class="body">
    ${UI.helpA?`<div class="ai">${esc(UI.helpA)}</div>`:""}
    <p class="small muted">${Store.sample?"Claude answers only from the rules below and names the source.":"Showing matching rules (Claude isn't available in this view)."} Not official policy.</p>
    ${hits.map(p=>`<div class="issue"><span class="pill p-info">${esc(p[0])}</span><div><div>${esc(p[1])}</div><div class="src">${esc(p[2])}</div></div></div>`).join("")||`<p class="muted">No rule matches. Try the contacts below.</p>`}
    <div class="hr"></div><h3>Who do I ask?</h3>
    ${CONTACTS.map(c=>`<div><div class="small muted">${esc(c[0])}</div><div><b>${esc(c[1])}</b></div><div class="mono small" style="user-select:all">${esc(c[2])}</div></div>`).join("")}
  </div>`;
}
async function askPolicy(q){
  UI.helpQ=q; UI.helpA=null; renderDrawer(); if(!q.trim()||!Store.sample)return;
  UI.helpA="Thinking…"; renderDrawer();
  try{
    const r=await Store.sample(`You help Miami University student org treasurers with ASG funding and university spending rules. Answer in 2-4 plain sentences using ONLY these rules; cite the source in brackets. If the rules don't answer it, say so and name who to contact.\nRULES:\n${POLICY.map(p=>`- ${p[0]}: ${p[1]} [${p[2]}]`).join("\n")}\nCONTACTS:\n${CONTACTS.map(c=>`- ${c[0]}: ${c[1]}, ${c[2]}`).join("\n")}\nQUESTION: ${q}`,{modelTier:"quick",onText:u=>{UI.helpA=u.text;const el=$("#drawer .ai");if(el)el.textContent=u.text}});
    UI.helpA=r.text;
  }catch(e){UI.helpA=e&&e.code==="not_granted"?"Claude access wasn't granted for this page. The matching rules are listed below.":"Couldn't reach Claude. The matching rules are listed below."}
  renderDrawer();
}

/* ============================== EVENTS ============================== */
function setPath(obj,path,val){const ks=path.split(".");let o=obj;for(let i=0;i<ks.length-1;i++)o=o[ks[i]];o[ks[ks.length-1]]=val}
function renderMeetingLive(){
  if(UI.role!=="org"||UI.step!==1){return}
  const tx=$("#tx"); if(!tx){render();return}
  SCRIPT.forEach((_,i)=>{const el=$("#utt-"+i);if(!el)return;el.classList.toggle("on",UI.playing===i);el.style.opacity=(UI.playing>=0&&i>UI.playing)?".45":""});
  const on=$("#utt-"+UI.playing); if(on)tx.scrollTop=on.offsetTop-tx.offsetTop-40;
  const head=tx.closest(".sub").querySelector(".row .row");
  if(head)head.innerHTML=UI.playing>=0?`<span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><button class="btn" data-act="stop">Stop</button>`:`<button class="btn primary" data-act="play">▶ Play sample exec meeting</button>`;
}
document.addEventListener("click",e=>{
  const r=e.target.closest("[data-role]"); if(r){UI.role=r.dataset.role;lsSet("rf.role",UI.role);stopMeeting(true);render();window.scrollTo(0,0);return}
  const s=e.target.closest("[data-step]"); if(s&&!s.dataset.act){UI.step=+s.dataset.step;lsSet("rf.step",UI.step);stopMeeting(true);render();return}
  const qa=e.target.closest("[data-asg]"); if(qa){UI.asgSel=qa.dataset.asg;UI.asgDraft=null;UI.asgAi=null;render();return}
  const qp=e.target.closest("[data-ap]"); if(qp){UI.apSel=qp.dataset.ap;render();return}
  if(e.target.closest("#help-open")){UI.help=!UI.help;renderDrawer();return}
  const b=e.target.closest("[data-act]"); if(!b)return;
  const act=b.dataset.act; const app=cur();
  const A={
    "new":newApp, "restart":newApp,
    "play":playMeeting, "stop":()=>stopMeeting(false),
    "use-script":()=>{app.transcript=scriptText();save(app);render()},
    "generate":generateBudget,
    "fix":()=>{autoFix(app,b.dataset.kind);save(app);render()},
    "add-event":()=>{app.events.push({id:uid(),type:"Event",name:"",date:"",people:0,nights:0,flightPeople:0,onHub:false});save(app);render()},
    "del-event":()=>{app.events=app.events.filter(x=>x.id!==b.dataset.id);app.lines=app.lines.filter(l=>l.eventId!==b.dataset.id||l.group!=="event");save(app);render()},
    "add-line":()=>{const g=b.dataset.group;app.lines.push(mkLine(g,g==="event"?app.events[0]?.id:null,"",g==="event"?"Event: Food":"Admin Item",0,"",""));save(app);render()},
    "del-line":()=>{app.lines=app.lines.filter(l=>l.id!==b.dataset.id);save(app);render()},
    "submit":submitProposal,
    "goto":()=>{UI.step=+b.dataset.step;lsSet("rf.step",UI.step);render()},
    "revise":()=>{app.status="draft";log(app,"Org","Reopened the proposal to revise");UI.step=2;save(app);render()},
    "submit-sa":submitSA,
    "copy-sa":()=>{const sa=app.sa;const txt=["Spend category\tAmount\tMemo",...sa.lines.map(l=>`${l.sc==="FUEL"?"Car Fuel":l.sc+" "+SPEND_CATS[l.sc]}\t${l.amount.toFixed(2)}\t${l.memo}`),`Justification\t\t${sa.justification}`].join("\n");
      navigator.clipboard.writeText(txt).then(()=>toast("Copied for Workday")).catch(()=>toast("Copy blocked here; select the table instead"))},
    "read-all":()=>{app.notices.forEach(n=>{if(n.to==="org")n.read=true});save(app);render()},
    "sample-receipts":()=>loadSampleReceipts(app),
    "del-receipt":()=>{app.receipts=app.receipts.filter(r=>r.id!==b.dataset.id);save(app);render()},
    "asg-fill-reasons":()=>{const a=Store.apps[UI.asgSel];const v=validate(a);a.lines.forEach(l=>{const f=v.all.find(i=>i.lineId===l.id&&i.sev!=="info");if(f&&!UI.asgDraft.reasons[l.id])UI.asgDraft.reasons[l.id]=`${f.msg} (${f.src})`});render()},
    "asg-approve":()=>asgCommit(Store.apps[UI.asgSel],false),
    "asg-deny":()=>{if(!UI.asgDraft.note.trim()){toast("Add a note explaining the denial");$("#asg-note")?.focus();return}asgCommit(Store.apps[UI.asgSel],true)},
    "asg-ai":async()=>{const a=Store.apps[UI.asgSel];const v=validate(a);UI.asgAi="Drafting…";render();
      try{const r=await Store.sample(`Draft a short, kind note (3-5 sentences) from the ASG Secretary of Treasury to a student org about its funding proposal. Cite the policy source for each reduction. Lines (requested -> proposed approval): ${a.lines.map(l=>`${l.item} [${l.category}] $${l.amount} -> $${UI.asgDraft.approved[l.id]}`).join("; ")}. Flags: ${v.reviews.map(i=>i.msg+" ("+i.src+")").join("; ")||"none"}.`,{modelTier:"quick"});UI.asgAi=null;UI.asgDraft.note=r.text}catch(e){UI.asgAi="Couldn't reach Claude."}render()},
    "ap-approve":()=>apDecide(Store.apps[UI.apSel],true,($("#ap-note")?.value||"").trim()),
    "ap-return":()=>{const n=($("#ap-note")?.value||"").trim();if(!n){toast("Add a note so the org knows what to fix");$("#ap-note")?.focus();return}apDecide(Store.apps[UI.apSel],false,n)},
    "ap-picked":()=>{const v=($("#ap-last4")?.value||"").replace(/\D/g,"").slice(0,4);markPicked(Store.apps[UI.apSel],v)},
    "ap-ai":async()=>{const a=Store.apps[UI.apSel];UI.apAi={id:a.id,text:"Reviewing…"};render();
      try{const r=await Store.sample(`You assist Miami University Accounts Payable reviewing a student org purchasing-card Spend Authorization. Rules: never cash advance; one accounting string; total must not exceed ASG approval ($${sum(Object.values(a.asg.approved))}); no alcohol/tobacco/gambling; clothing with Miami logo needs review; rental vehicles need a separate RENTAL/GAS CARDS request with one card per vehicle; nothing after June 1. In 3 sentences, recommend approve or return and why.\nAuthorization: ${JSON.stringify({total:a.sa.total,description:a.sa.description,lines:a.sa.lines.map(l=>({category:SPEND_CATS[l.sc],amount:l.amount,memo:l.memo})),justification:a.sa.justification})}`,{modelTier:"quick"});UI.apAi={id:a.id,text:r.text}}catch(e){UI.apAi={id:a.id,text:"Couldn't reach Claude."}}render()},
    "help-close":()=>{UI.help=false;renderDrawer()}
  };
  if(A[act])A[act]();
});
document.addEventListener("input",e=>{
  const el=e.target;
  if(el.dataset.asgamt){UI.asgDraft.approved[el.dataset.asgamt]=el.value;return}
  if(el.dataset.asgreason){UI.asgDraft.reasons[el.dataset.asgreason]=el.value;return}
  if(el.dataset.asgnote){UI.asgDraft.note=el.value;return}
  if(el.id==="help-q"){UI.helpQ=el.value;return}
  const p=el.dataset.bind; if(!p)return; const app=cur(); if(!app)return;
  if(el.type==="checkbox"||el.tagName==="SELECT")return; // handled on change
  let v=el.value; if(el.type==="number")v=el.value===""?"":Number(el.value);
  setPath(app,p,v); save(app); renderSide();
});
document.addEventListener("change",e=>{
  const el=e.target;
  if(el.id==="pick-app"&&el.value){UI.appId=el.value;lsSet("rf.app",el.value);render();return}
  if(el.dataset.quote){const app=cur();const l=app.lines.find(x=>x.id===el.dataset.quote);if(l&&el.files[0]){l.quote=el.files[0].name;log(app,"Org",`Attached quote ${el.files[0].name} to ${l.item}`);save(app);render()}return}
  if(el.id==="tx-file"&&el.files[0]){const fr=new FileReader();fr.onload=()=>{const app=cur();app.transcript=String(fr.result||"");save(app);render()};fr.readAsText(el.files[0]);return}
  const p=el.dataset.bind; if(!p)return; const app=cur(); if(!app)return;
  if(el.type==="checkbox")setPath(app,p,el.checked);
  else if(el.tagName==="SELECT")setPath(app,p,el.dataset.num?Number(el.value):el.value);
  else return;
  if(p.startsWith("sa.lines")){/* category edits keep amounts */ app.sa.lines.forEach(l=>{l.sure=Object.values(CAT_MAP).some(m=>m.sc===l.sc&&m.sure)})}
  save(app); render();
});
document.addEventListener("submit",e=>{
  e.preventDefault();
  if(e.target.id==="help-form"){askPolicy($("#help-q").value);return}
  if(e.target.id==="rc-form"){const app=cur();
    const r={id:uid(),date:$("#rc-date").value,vendor:$("#rc-vendor").value.trim(),amount:Number($("#rc-amount").value)||0,tip:Number($("#rc-tip").value)||0,refund:0,lineId:$("#rc-line").value,who:app.org.treasurer,what:$("#rc-what").value.trim(),where:"Oxford, OH",why:$("#rc-what").value.trim()?"ASG-funded org activity":""};
    if(!r.vendor||!r.amount){toast("Add a vendor and amount");return}
    app.receipts.push(r);log(app,"Org",`Logged ${r.vendor} ${money(r.amount)}`);save(app);render();toast("Receipt added")}
});

/* ============================== BOOT ============================== */
loadLocal(); renderStore();
if(UI.appId&&!Store.apps[UI.appId])UI.appId=null;
render();
connect();
window.__rf={parseTranscript,validate,totals,scriptText,blankApp,buildSA,ledger,apChecks};
</script>

