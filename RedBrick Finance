  if(!a)return `<div class="banner info"><b>Not submitted yet</b><p>Finish Step 2 first.</p></div>`;
  const tone=a.decision==="denied"?"bad":a.decision==="partial"?"warn":"ok";
  const word={auto:"Approved instantly",approved:"Approved",partial:"Partly approved",denied:"Denied"}[a.decision];
  return `<div class="banner ${tone}"><b>${word}</b><p>${money(sum(Object.values(a.approved)))} of ${money(totals(app).total)} · ${esc(a.reviewer)} · ${day(a.at)} ${clock(a.at)}</p></div>`;
}
