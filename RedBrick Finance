      ${[...app.receipts].sort((a,b)=>b.date.localeCompare(a.date)).map(r=>{const i=app.receipts.indexOf(r);return `<tr><td class="num">${esc(r.date)}</td><td>${esc(r.vendor)}${r.sample?` <span class="pill p-mute">sample</span>`:""}${Number(r.tip)>0?` <span class="pill p-warn">tip ${money(r.tip)}</span>`:""}${Number(r.refund)>0?` <span class="pill p-info">refund ${money(r.refund)}</span>`:""}</td><td class="r num">${money(r.amount)}</td><td><select data-bind="receipts.${i}.lineId" aria-label="Budget line">${lineOpts(r.lineId)}</select></td><td class="small">${r.who&&r.what&&r.where&&r.why?`<span class="pill p-ok">Answered</span>`:`<span class="pill p-warn">Incomplete</span>`} <span class="muted">${esc(r.what||"")}</span></td><td><button class="icon-btn" data-act="del-receipt" data-id="${r.id}" aria-label="Remove">✕</button></td></tr>`}).join("")}
    </tbody></table></div>`:`<div class="empty"><b>No receipts yet</b><span>Log each purchase as you make it, or load the sample receipts to see flags.</span></div>`}
  </div>`;
}

/* ============================== ASG VIEW ============================== */
function asgView(){
  const apps=Object.values(Store.apps).filter(a=>a.status!=="draft").sort((a,b)=>(b.submittedAt||"").localeCompare(a.submittedAt||""));
  if(!UI.asgSel||!Store.apps[UI.asgSel])UI.asgSel=(apps.find(a=>a.status==="review")||apps[0]||{}).id;
  const sel=Store.apps[UI.asgSel];
  return `<div class="panel-head" style="margin-bottom:16px"><div><span class="eyebrow">ASG Funding Committee</span><h2>Secretary of Treasury queue</h2></div><span class="small muted">Clean proposals are approved automatically. Only flagged ones land here.</span></div>
  <div class="grid-q">
    <div class="q">${apps.length?apps.map(a=>`<button class="qi" data-asg="${a.id}" aria-current="${a.id===UI.asgSel}"><div class="row"><b>${esc(a.org.name)}</b>${statusPill(a.status)}</div><div class="small muted">Tier ${a.org.tier} · ${money(totals(a).total)} · ${a.asg?.decision==="auto"?"auto-approved":validate(a).reviews.length+" flag(s)"}</div></button>`).join(""):`<div class="empty"><b>No submissions</b><span>Submit a proposal from the Org treasurer view.</span></div>`}</div>
    <div>${sel?asgDetail(sel):""}</div>
  </div>`;
}
function asgDetail(app){
  const v=validate(app); const decided=app.status!=="review";
  const flagsFor=id=>v.all.filter(i=>i.lineId===id&&i.sev!=="info");
  const draft=UI.asgDraft&&UI.asgDraft.id===app.id?UI.asgDraft:(UI.asgDraft={id:app.id,approved:Object.fromEntries(app.lines.map(l=>[l.id,decided?Number(app.asg?.approved?.[l.id]||0):Number(l.amount)])),reasons:{...(app.asg?.reasons||{})},note:app.asg?.note||""});
  return `<div class="panel">
    <div class="panel-head"><div><span class="eyebrow">Tier ${app.org.tier} · ${esc(app.org.sa)} · submitted ${day(app.submittedAt)}</span><h2>${esc(app.org.name)}</h2></div>${statusPill(app.status)}</div>
    <dl class="kv"><dt>Treasurer</dt><dd>${esc(app.org.treasurer)} · ${esc(app.org.treasurerEmail)}</dd><dt>Advisor</dt><dd>${esc(app.org.advisor)}</dd><dt>Events</dt><dd>${app.events.map(e=>`${esc(e.name)} <span class="muted">(${esc(e.date)})</span>${e.onHub?"":` <span class="pill p-bad">not on Hub</span>`}`).join("<br>")}</dd></dl>
    ${v.reviews.length?`<div class="issues">${v.reviews.map(i=>issueHtml(i)).join("")}</div>`:""}
    <div class="tbl-wrap"><table><thead><tr><th>Line</th><th>Category</th><th class="r">Requested</th><th class="r">Approve ($)</th><th>Reason shown to the org</th></tr></thead><tbody>
      ${app.lines.map(l=>`<tr><td>${esc(l.item)}${flagsFor(l.id).length?` <span class="pill p-warn">flag</span>`:""}<div class="small muted">${esc(eventOf(app,l.eventId)?.name||"Non-event")}</div></td><td class="small">${esc(l.category)}</td><td class="r num">${money(l.amount)}</td>
      <td style="width:120px"><input type="number" step="0.01" min="0" data-asgamt="${l.id}" value="${draft.approved[l.id]}" ${decided?"disabled":""} aria-label="Approved amount"></td>
      <td style="min-width:200px"><input type="text" data-asgreason="${l.id}" value="${esc(draft.reasons[l.id]||"")}" placeholder="${flagsFor(l.id).length?esc(flagsFor(l.id)[0].src):"Optional"}" ${decided?"disabled":""} aria-label="Reason"></td></tr>`).join("")}
    </tbody></table></div>
    <label class="f" for="asg-note">Note to the org <textarea id="asg-note" data-asgnote="1" rows="3" ${decided?"disabled":""} placeholder="Explain the decision and cite the policy.">${esc(draft.note)}</textarea></label>
    ${decided?asgDecisionBanner(app):`<div class="row" style="justify-content:space-between"><div class="row">
      <button class="btn" data-act="asg-fill-reasons">Fill reasons from policy</button>
      <button class="btn" data-act="asg-ai" ${Store.sample?"":"disabled"}>Draft note with Claude</button></div>
      <div class="row"><button class="btn bad" data-act="asg-deny">Deny</button><button class="btn good" data-act="asg-approve">Approve as entered</button></div></div>`}
    ${UI.asgAi?`<div class="ai">${esc(UI.asgAi)}</div>`:""}
  </div>`;
}
function asgCommit(app,deny){
  const d=UI.asgDraft; const approved={}; let partial=false;
  app.lines.forEach(l=>{const v=deny?0:Math.max(0,Math.min(Number(l.amount),Number(d.approved[l.id])||0));approved[l.id]=v;if(v<Number(l.amount))partial=true});
  const decision=deny?"denied":partial?"partial":"approved";
  app.asg={decision,reviewer:"Secretary of Treasury",note:d.note||(deny?"Denied. See line reasons.":partial?"Approved with reductions. See line reasons.":"Approved as requested."),approved,reasons:d.reasons,at:now()};
  app.status=decision==="denied"?"denied":decision; app.sa=null;
  log(app,"ASG",`${{approved:"Approved",partial:"Partly approved",denied:"Denied"}[decision]} by Secretary of Treasury: ${money(sum(Object.values(approved)))}`);
  notify(app,"org",decision==="denied"?"ASG denied your proposal. Every reason is listed in Step 3; revise and resubmit from there.":`ASG ${decision==="partial"?"partly approved":"approved"} ${money(sum(Object.values(approved)))}. Your Spend Authorization is ready to generate.`,true);
  UI.asgDraft=null; UI.asgAi=null; save(app,{now:true}); render(); toast("Decision sent to the org");
}

/* ============================== AP VIEW ============================== */
function apView(){
  const apps=Object.values(Store.apps).filter(a=>a.sa&&a.sa.submittedAt).sort((a,b)=>(b.sa.submittedAt||"").localeCompare(a.sa.submittedAt||""));
  if(!UI.apSel||!Store.apps[UI.apSel]||!Store.apps[UI.apSel].sa)UI.apSel=(apps.find(a=>a.status==="sa_submitted")||apps.find(a=>a.status==="card_ready")||apps[0]||{}).id;
  const sel=Store.apps[UI.apSel];
  return `<div class="panel-head" style="margin-bottom:16px"><div><span class="eyebrow">Accounts Payable · 107 Roudebush Hall</span><h2>Spend Authorization queue</h2></div><span class="small muted">The system suggests; Accounts Payable decides.</span></div>
  <div class="grid-q">
    <div class="q">${apps.length?apps.map(a=>`<button class="qi" data-ap="${a.id}" aria-current="${a.id===UI.apSel}"><div class="row"><b>${esc(a.org.name)}</b>${statusPill(a.status)}</div><div class="small muted">${money(a.sa.total)} · ${esc(a.sa.description)} · ${day(a.sa.submittedAt)}</div></button>`).join(""):`<div class="empty"><b>Queue is empty</b><span>Spend Authorizations appear here after an org submits one.</span></div>`}</div>
    <div>${sel?apDetail(sel):""}</div>
