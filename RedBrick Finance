    return {line:l,approved:Number(approved[l.id]),spent,left:Math.round((Number(approved[l.id])-spent)*100)/100,count:rs.length};
  });
  const un=app.receipts.filter(r=>!r.lineId||!rows.some(x=>x.line.id===r.lineId));
  const spent=sum(app.receipts.map(r=>Number(r.amount)-Number(r.refund||0)));
  const approvedTotal=sum(Object.values(approved));
  const flags=[];
  rows.filter(r=>r.left<0).forEach(r=>flags.push({sev:"error",msg:`${r.line.item} is over its approved ${money(r.approved)} by ${money(-r.left)}. Cover the difference from agency funds or ask ASG.`}));
  if(un.length)flags.push({sev:"review",msg:`${un.length} receipt(s) totaling ${money(sum(un.map(r=>Number(r.amount)-Number(r.refund||0))))} don't match any approved line. ASG funds must follow the approved budget.`});
